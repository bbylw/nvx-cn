---
// 基础布局：字体、元信息与全站拼板外壳
import '../styles/global.css';
import { canonicalPath, withBase } from '../lib/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, noindex = false, ogType = 'website' } = Astro.props;

// BASE_URL 可能与 Astro.url.pathname 已经包含的前缀重复，这里做一次兜底。
const base = import.meta.env.BASE_URL;
const pathname =
  base !== '/' && !Astro.url.pathname.startsWith(base)
    ? withBase(Astro.url.pathname)
    : Astro.url.pathname;
const canonical =
  Astro.site && !noindex
    ? new URL(canonicalPath(pathname), Astro.site)
    : null;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f0f0f" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="NVX 中文站" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // 仅在脚本可用时隐藏入场元素；2.5 秒内模块脚本未就绪则整体回退为可见。
      document.documentElement.classList.add('js');
      window.setTimeout(function () {
        if (document.documentElement.dataset.reveal !== 'ready') {
          document.documentElement.classList.remove('js');
        }
      }, 2500);
    </script>
  </head>
  <body class="bg-bg font-text text-ink">
    <a class="skip-link" href="#main">跳到主要内容</a>
    <slot />
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <script>
      // 入场动效：进入视口时给 .reveal 加 is-in；脚本失败时由 Base 中的计时器回退为可见。
      const items = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
      document.documentElement.dataset.reveal = 'ready';
      const show = (el: HTMLElement) => {
        const delay = Number(el.dataset.delay ?? 0);
        el.style.animationDelay = `${delay}ms`;
        el.classList.add('is-in');
      };
      if (items.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                show(entry.target as HTMLElement);
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
        // 兜底：4 秒后仍未进入视口的元素直接显示，
        // 避免锚点跳转、打印或截图时内容永久隐藏。
        window.setTimeout(() => {
          for (const el of items) {
            if (!el.classList.contains('is-in')) {
              show(el);
              io.unobserve(el);
            }
          }
        }, 4000);
      } else {
        items.forEach((el) => show(el));
      }
    </script>
  </body>
</html>
