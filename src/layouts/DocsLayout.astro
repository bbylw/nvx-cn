---
// 文档页外壳：左侧目录、正文砖、右侧本页目录；移动端折叠目录。
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import DocsNav from '../components/DocsNav.astro';
import TopRow from '../components/TopRow.astro';
import type { DocEntry } from '../lib/docs';
import { groupDocs, groupLabels, navGroupOrder, sourceHref } from '../lib/docs';
import { withBase } from '../lib/site';

interface Heading {
  depth: number;
  text: string;
  slug: string;
}

interface Props {
  title: string;
  description: string;
  headings?: Heading[];
  entry?: DocEntry;
  prev?: DocEntry | null;
  next?: DocEntry | null;
  isHome?: boolean;
}

const {
  title,
  description,
  headings = [],
  entry,
  prev = null,
  next = null,
  isHome = false,
} = Astro.props;

const docs = await getCollection('docs');
const groups = groupDocs(docs);
const total = navGroupOrder.reduce((count, group) => count + groups[group].length, 0);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const groupLabel = entry ? groupLabels[entry.data.group] : '文档';
const inDesign = entry?.data.group === 'design';
const pageTitle = isHome ? 'NVX 中文文档 · NVX 中文站' : `${title} · NVX 文档`;
const source = entry?.data.source;
---

<Base title={pageTitle} description={description} ogType={isHome ? 'website' : 'article'}>
  <div class="p-2">
    <TopRow current="docs" />

    <main id="main" class="mt-2">
      <div class="docs-shell">
        <aside class="docs-sidebar hidden lg:block" aria-label="文档目录">
          <div class="tile bg-surface p-3">
            <div class="flex items-baseline justify-between gap-3 px-3 pt-1">
              <p class="text-small text-muted">文档</p>
              <p class="text-small tabular-nums text-muted">{total} 篇</p>
            </div>
            <div class="mt-3">
              <DocsNav groups={groups} activeId={entry?.id} isHome={isHome} showNotes={true} />
            </div>
          </div>
        </aside>

        <div class="min-w-0">
          <details class="docs-mobile-nav tile bg-surface p-3 lg:hidden">
            <summary class="press flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-1">
              <span class="text-body">文档目录</span>
              <span class="text-small text-muted">{groupLabel} · {total} 篇</span>
            </summary>
            <div class="mt-2 border-t border-white/10 pt-2">
              <DocsNav groups={groups} activeId={entry?.id} isHome={isHome} />
            </div>
          </details>

          <article class="tile mt-2 bg-surface p-5 md:p-8 lg:mt-0 lg:p-10" aria-labelledby="doc-title">
            {isHome ? (
              <h1 id="doc-title" class="sr-only">{title}</h1>
            ) : (
              <>
                <div class="flex flex-wrap items-center justify-between gap-3 text-small text-muted">
                  <p>
                    <a class="press hover:text-accent" href={withBase('/docs/')}>文档</a>
                    <span class="px-2 text-muted/60">/</span>
                    {inDesign ? (
                      <>
                        <a class="press hover:text-accent" href={withBase('/docs/design/')}>架构设计</a>
                        <span class="px-2 text-muted/60">/</span>
                        <span>{groupLabel}</span>
                      </>
                    ) : (
                      <span>{groupLabel}</span>
                    )}
                  </p>
                  {entry && <p class="tabular-nums">{String(entry.data.order).padStart(2, '0')}</p>}
                </div>

                <h1 id="doc-title" class="docs-title mt-4 font-display">{title}</h1>
                <p class="mt-5 max-w-[64ch] text-lead text-muted">{description}</p>
              </>
            )}

            {source && (
              <p class="mt-5 border-t border-white/10 pt-4 text-small text-muted">
                译自
                <a
                  class="press underline underline-offset-4 hover:text-accent hover:no-underline"
                  href={sourceHref(source)}
                >
                  microsoft/nvx · {source}
                </a>
                。技术细节以英文原文为准。
              </p>
            )}

            <div class:list={['docs-prose', isHome ? 'mt-0' : 'mt-8']}>
              <slot />
            </div>

            {(prev || next) && (
              <nav class="mt-10 grid gap-2 border-t border-white/10 pt-6 sm:grid-cols-2" aria-label="文档翻页">
                {prev ? (
                  <a class="press group bg-mid p-4 hover:bg-accent hover:text-accent-ink" href={withBase(`/docs/${prev.id}/`)}>
                    <span class="block text-small text-muted group-hover:text-accent-ink">上一篇</span>
                    <span class="mt-1 block text-body">{prev.data.title}</span>
                  </a>
                ) : (
                  <span class="hidden sm:block" />
                )}
                {next ? (
                  <a class="press group bg-mid p-4 text-right hover:bg-accent hover:text-accent-ink" href={withBase(`/docs/${next.id}/`)}>
                    <span class="block text-small text-muted group-hover:text-accent-ink">下一篇</span>
                    <span class="mt-1 block text-body">{next.data.title}</span>
                  </a>
                ) : (
                  <span class="hidden sm:block" />
                )}
              </nav>
            )}
          </article>

          <footer class="mt-2">
            <div class="tile bg-surface p-5 md:p-6">
              <div class="flex flex-wrap items-center justify-between gap-4">
                <nav class="flex flex-wrap gap-x-10 gap-y-3 text-small" aria-label="页脚导航">
                  <a class="press hover:text-accent" href={withBase('/')}>返回首页</a>
                  <a class="press hover:text-accent" href={withBase('/docs/')}>文档首页</a>
                  <a class="press hover:text-accent" href="https://github.com/microsoft/nvx">GitHub 仓库</a>
                  <a class="press hover:text-accent" href="https://github.com/microsoft/nvx/issues">问题反馈</a>
                  <a class="press hover:text-accent" href={withBase('/NOTICE.txt')}>许可与归属</a>
                </nav>
                <p class="text-small text-muted">非官方中文文档 · 内容以上游原文为准</p>
              </div>
            </div>
          </footer>
        </div>

        {toc.length > 0 ? (
          <aside class="docs-toc hidden xl:block" aria-label="本页目录">
            <nav class="tile bg-surface p-4">
              <p class="px-1 text-small text-muted">本页目录</p>
              <ol class="mt-3 space-y-1">
                {toc.map((heading) => (
                  <li>
                    <a
                      class:list={[
                        'press block border-l border-white/10 py-1 text-small leading-snug text-muted hover:border-accent hover:text-ink',
                        heading.depth === 2 ? 'pl-3' : 'pl-6',
                      ]}
                      href={`#${heading.slug}`}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        ) : (
          <aside class="docs-toc hidden xl:block" aria-label="上游资源">
            <div class="tile bg-surface p-4">
              <p class="px-1 text-small text-muted">上游资源</p>
              <ul class="mt-3 space-y-2 text-small">
                <li>
                  <a class="press block border-l border-white/10 py-1 pl-3 text-muted hover:border-accent hover:text-ink" href="https://github.com/microsoft/nvx">
                    GitHub 仓库
                  </a>
                </li>
                <li>
                  <a class="press block border-l border-white/10 py-1 pl-3 text-muted hover:border-accent hover:text-ink" href="https://github.com/microsoft/nvx/tree/dev/doc">
                    上游文档目录
                  </a>
                </li>
                <li>
                  <a class="press block border-l border-white/10 py-1 pl-3 text-muted hover:border-accent hover:text-ink" href="https://github.com/microsoft/nvx/issues">
                    问题反馈
                  </a>
                </li>
              </ul>
            </div>
          </aside>
        )}
      </div>
    </main>
  </div>
</Base>
